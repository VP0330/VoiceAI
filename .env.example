# Ollama configuration
OLLAMA_BASE_URL=
OLLAMA_MODEL=


# PostgreSQL Database
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=    

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# Voice Services
# STT: Deepgram (requires API key from https://console.deepgram.com)
DEEPGRAM_API_KEY=

# TTS: pyttsx3 (local, no API key needed, runs offline using system voices)
# Uses Windows SAPI, macOS NSSpeechSynthesizer, or Linux espeak
# No configuration needed - just make sure pyttsx3 is installed: pip install pyttsx3==2.90
